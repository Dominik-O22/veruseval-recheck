+
+
+/*
+ * Local patch: skeleton mode (env LYNETTE_SKELETON) emits the frozen part of a file as compilable
+ * Verus: the code `compare -t` checks, plus return names, fn attributes and
+ * exec_allows_no_decreases_clause, all of which `compare -t` ignores.
+ */
+pub fn skeleton_mode() -> bool {
+    std::env::var_os("LYNETTE_SKELETON").is_some()
+}
+
+fn skeleton_attrs(attrs: &Vec<syn_verus::Attribute>) -> Vec<syn_verus::Attribute> {
+    let mut attrs = attrs.clone();
+    attrs.push(syn_verus::parse_quote!(#[verifier::exec_allows_no_decreases_clause]));
+    attrs
+}
+
+pub fn skeleton_source(filepath: PathBuf, mode: &DeghostMode) -> Result<String, Error> {
+    let orig_file = fload_file(&filepath)?;
+    let mut out = String::new();
+    let mut pure = TokenStream::new();
+    remove_verus_macro(&orig_file).to_tokens(&mut pure);
+    out.push_str(&pure.to_string());
+    // One item per line, so Verus error lines map back to items.
+    for vm in extract_verus_macro(&orig_file)? {
+        out.push_str("\nverus! {\n");
+        for item in remove_ghost_from_file(&vm, mode).items {
+            let mut ts = TokenStream::new();
+            item.to_tokens(&mut ts);
+            out.push_str(&format!("{}\n", ts));
+        }
+        out.push_str("}\n");
+    }
+    Ok(out)
+}
